# Server Configuration
PORT=4000
NODE_ENV=production

# Rendering Mode: 'local' (local Chromium rendering) or 'lambda' (AWS Lambda rendering)
RENDER_MODE=local

# AWS Lambda Configuration (Required when RENDER_MODE=lambda)
# Your AWS IAM credentials with AWSLambda_FullAccess and AmazonS3FullAccess
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1

# Remotion Lambda deployed function name and site URL (obtained after running deploy commands)
# Example: remotion-render-4-0-526-mem3008mb-disk2048mb-120sec
REMOTION_FUNCTION_NAME=
# Example: https://remotionlambda-useast1-xxxx.s3.us-east-1.amazonaws.com/sites/ctrlaltwin/index.html
REMOTION_SERVE_URL=
# Frames rendered per micro-worker (30 frames = 1s per lambda, ~50 lambdas render in 5-8s)
REMOTION_FRAMES_PER_LAMBDA=30

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# Google AI Studio Configuration (backup)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# TTS Provider Configuration
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Image Provider Configuration (uses Pollinations AI free generator by default)
IMAGE_PROVIDER=mock

